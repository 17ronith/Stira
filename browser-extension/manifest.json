{
  "manifest_version": 3,
  "name": "Stira",
  "version": "0.1.0",
  "description": "Stira focus enforcement",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background/service_worker.js"
  },
  "declarative_net_request": {
    "rule_resources": []
  }
}
